<% macro sync_functions(sync) %>
${{ sync.fn_name }}_preflight() {
${{ sync.preflight | indent(4, first=true) }}
}

${{ sync.fn_name }}() {
    nbkp_log "Starting sync: ${{ sync.slug }}"
<% for step in sync.steps %>

    # ${{ step.title }}
${{ step.body | indent(4, first=true) }}
<% endfor %>

    nbkp_log "Completed sync: ${{ sync.slug }}"
}
<% endmacro %>
#!/bin/bash
# Generated by nbkp sh — ${{ timestamp }}
${{ config_line }}
#
# Preserved from nbkp run:
#   - All 4 rsync command variants (local→local, local→remote, remote→local, remote→remote)
#   - SSH options (port, key, -o options, proxy jump -J)
#   - Rsync filters and filter-file support
#   - Btrfs: snapshot creation, latest symlink, pruning
#   - Hard-link: incremental backups via --link-dest, orphan cleanup, latest symlink,
#     pruning, removal of the new snapshot after a failed rsync
#   - Pre-flight checks, run for every sync before any sync starts:
#       inactive (expected, transient): volume sentinels (.nbkp-vol), endpoint
#         sentinels (.nbkp-src/.nbkp-dst), unreachable hosts
#       broken (infrastructure): rsync presence and version (GNU rsync 3.0+, no
#         openrsync), snapshot tools (btrfs, stat, findmnt, readlink, ls, ln,
#         mkdir, rm), btrfs filesystem / user_subvol_rm_allowed / staging
#         subvolume, FAT/exFAT rejection for hard links, snapshots/ and staging/
#         directories, source and destination latest symlink validity,
#         destination writability
#   - Strictness (--strictness ignore-inactive|ignore-none|ignore-all, default
#     ignore-inactive): inactive syncs are skipped without failing the run,
#     infrastructure errors abort it before any sync starts
#   - Failure propagation: syncs downstream of a failed or skipped sync are cancelled
#   - Dry-run and progress mode support (as runtime script arguments)
#   - Nonzero exit on any sync failure
#
# Dropped from nbkp run:
#   - Rich console output (spinners, tables, progress bars) → simple log messages
#   - JSON output mode → not applicable for a shell script
#   - Python runtime / config parsing → all values hardcoded
#   - Endpoint selection (--location, --network) → resolved once, at generation time
#   - Paramiko-only SSH options (channel_timeout, disabled_algorithms) → no ssh CLI equivalent
#   - Orphan cleanup during --dry-run → a dry-run here never modifies the destination
#   - Preflight probes of the orchestrator's own coreutils (date, sort, grep, wc) →
#     the script itself cannot run without them
#   - Volume mount management (udisks LUKS unlock/lock, mount/umount) → credential
#     retrieval depends on keyring/prompt/command backends that don't translate to shell.
#     Volumes with mount config must be manually mounted/umounted before/after running
#     this script. Use: nbkp disks mount -c <config> / nbkp disks umount -c <config>

# Unofficial bash strict mode (http://redsymbol.net/articles/unofficial-bash-strict-mode/)
set -euo pipefail
IFS=$'\n\t'
<% if has_script_dir %>

NBKP_SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
<% endif %>

NBKP_DRY_RUN=false
NBKP_PROGRESS=""
NBKP_STRICTNESS=ignore-inactive

# --- Argument parsing ---
while [ $# -gt 0 ]; do
  case "$1" in
    -n|--dry-run) NBKP_DRY_RUN=true; shift;;
    --progress=*) NBKP_PROGRESS="${1#--progress=}"; shift;;
    --progress|-p) NBKP_PROGRESS="$2"; shift 2;;
    --strictness=*) NBKP_STRICTNESS="${1#--strictness=}"; shift;;
    --strictness|-S) NBKP_STRICTNESS="$2"; shift 2;;
    *) echo "Unknown option: $1" >&2; exit 1;;
  esac
done
case "$NBKP_STRICTNESS" in
  ignore-inactive|ignore-none|ignore-all) ;;
  *) echo "Unknown strictness: $NBKP_STRICTNESS (use 'ignore-inactive', 'ignore-none', or 'ignore-all')" >&2; exit 1;;
esac

NBKP_FAILURES=0
NBKP_SKIPPED=0
nbkp_log() {
    local IFS=' '
    if [ "$NBKP_DRY_RUN" = true ]; then
        echo "[nbkp] [dry-run] $*" >&2
    else
        echo "[nbkp] $*" >&2
    fi
}

# --- Rsync runtime flags ---
RSYNC_DRY_RUN_FLAG=""
if [ "$NBKP_DRY_RUN" = true ]; then RSYNC_DRY_RUN_FLAG="--dry-run"; fi
RSYNC_PROGRESS_FLAGS=()
case "$NBKP_PROGRESS" in
  none) ;;
  overall) RSYNC_PROGRESS_FLAGS=(--info=progress2 --stats --human-readable);;
  per-file) RSYNC_PROGRESS_FLAGS=(-v --progress --human-readable);;
  full) RSYNC_PROGRESS_FLAGS=(-v --progress --info=progress2 --stats --human-readable);;
  "") ;;
  *) echo "Unknown progress mode: $NBKP_PROGRESS (use 'none', 'overall', 'per-file', or 'full')" >&2; exit 1;;
esac

# --- Helpers ---
# GNU rsync >= 3.0 (openrsync rejected); $1 is the output of `rsync --version`.
nbkp_rsync_version_ok() {
    case "$1" in
        *openrsync*) return 1;;
        *"version "[3-9].*|*"version "[1-9][0-9].*) return 0;;
        *) return 1;;
    esac
}
nbkp_contains() {
    case "$1" in *"$2"*) return 0;; *) return 1;; esac
}
# Whether $1 equals one of the '|'-separated words in $2.
nbkp_matches() {
    local IFS='|' word
    for word in $2; do
        if [ "$1" = "$word" ]; then return 0; fi
    done
    return 1
}
# Filter stdin to snapshot names (timestamps), oldest first. Other entries are
# ignored, which also makes the names safe to splice into remote commands.
nbkp_snapshot_names() {
    { grep -E '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.Z-]+$' || true; } | sort
}
<% if portable %>
NBKP_FAILED=" "
nbkp_mark_failed() {
    NBKP_FAILED="${NBKP_FAILED}$1 "
}
nbkp_has_failed() {
    case "$NBKP_FAILED" in *" $1 "*) return 0 ;; *) return 1 ;; esac
}
<% else %>
declare -A NBKP_FAILED=()
nbkp_mark_failed() {
    NBKP_FAILED[$1]=1
}
nbkp_has_failed() {
    [ "${NBKP_FAILED[$1]+set}" = "set" ]
}
<% endif %>
# Abort before any sync starts when preflight results are fatal under the
# chosen strictness. Arguments: the preflight return code of each sync.
nbkp_enforce_strictness() {
    local rc broken=0 inactive=0 fatal=0
    for rc in "$@"; do
        case "$rc" in
            0) ;;
            1) broken=$((broken + 1));;
            *) inactive=$((inactive + 1));;
        esac
    done
    case "$NBKP_STRICTNESS" in
        ignore-none) fatal=$((broken + inactive));;
        ignore-inactive) fatal=$broken;;
        ignore-all) fatal=0;;
    esac
    if [ "$fatal" -gt 0 ]; then
        nbkp_log "Aborting: preflight checks found errors in $fatal sync(s)"
        exit 1
    fi
}
# nbkp_run_sync SLUG FN PREFLIGHT_RC [UPSTREAM_FN...]
# Cancels when an upstream sync failed or was skipped, skips inactive syncs,
# otherwise runs FN in a subshell with `set -e` in force: a function called in
# a `||` or `if` context runs with errexit disabled, which would let a failed
# rsync carry on into snapshotting.
nbkp_run_sync() {
    local slug="$1" fn="$2" pf="$3" dep rc
    shift 3
    for dep in "$@"; do
        if nbkp_has_failed "$dep"; then
            nbkp_log "CANCELLED $slug: upstream sync failed or was skipped"
            nbkp_mark_failed "$fn"
            case "$pf" in
                2|3) NBKP_SKIPPED=$((NBKP_SKIPPED + 1));;
                *) NBKP_FAILURES=$((NBKP_FAILURES + 1));;
            esac
            return 0
        fi
    done
    case "$pf" in
        2) nbkp_log "SKIPPED $slug: inactive"
           nbkp_mark_failed "$fn"; NBKP_SKIPPED=$((NBKP_SKIPPED + 1)); return 0;;
        3) nbkp_log "SKIPPED $slug: source snapshot pending (dry-run)"
           NBKP_SKIPPED=$((NBKP_SKIPPED + 1)); return 0;;
        1) nbkp_log "SKIPPED $slug: preflight errors"
           nbkp_mark_failed "$fn"; NBKP_FAILURES=$((NBKP_FAILURES + 1)); return 0;;
    esac
    set +e
    ( set -e; "$fn" )
    rc=$?
    set -e
    if [ "$rc" -ne 0 ]; then
        nbkp_log "FAILED $slug"
        nbkp_mark_failed "$fn"
        NBKP_FAILURES=$((NBKP_FAILURES + 1))
    fi
    return 0
}

# --- Sync functions ---
<% for sync in syncs %>
<% if sync.enabled %>

${{ sync_functions(sync) | trim }}
<% else %>

# : disabled — ${{ sync.slug }}
${{ sync_functions(sync) | trim | comment_out }}
<% endif %>
<% endfor %>

# --- Preflight checks (all syncs, before any sync starts) ---
<% for sync in enabled_syncs %>
${{ sync.fn_name }}_preflight && NBKP_PF_${{ sync.fn_name }}=0 || NBKP_PF_${{ sync.fn_name }}=$?
<% endfor %>
nbkp_enforce_strictness<% for sync in enabled_syncs %> "$NBKP_PF_${{ sync.fn_name }}"<% endfor %>


# --- Run all syncs ---
<% for sync in syncs %>
<% if sync.enabled %>
nbkp_run_sync ${{ sync.slug }} ${{ sync.fn_name }} "$NBKP_PF_${{ sync.fn_name }}"<% for dep in sync.predecessors %> ${{ dep }}<% endfor %>

<% else %>
# ${{ sync.fn_name }}  # disabled
<% endif %>
<% endfor %>

# --- Summary ---
if [ "$NBKP_FAILURES" -gt 0 ]; then
    nbkp_log "$NBKP_FAILURES sync(s) failed"
    exit 1
fi
if [ "$NBKP_SKIPPED" -gt 0 ]; then
    nbkp_log "All active syncs completed successfully ($NBKP_SKIPPED skipped)"
else
    nbkp_log "All syncs completed successfully"
fi
