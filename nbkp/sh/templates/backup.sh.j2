<% macro sync_functions(sync) %>
${{ sync.fn_name }}_preflight() {
${{ sync.preflight | indent(4, first=true) }}
}

${{ sync.fn_name }}() {
    nbkp_log "Starting sync: ${{ sync.slug }}"
<% for step in sync.steps %>

    # ${{ step.title }}
${{ step.body | indent(4, first=true) }}
<% endfor %>

    nbkp_log "Completed sync: ${{ sync.slug }}"
}
<% endmacro %>
#!/bin/bash
# Generated by nbkp sh — ${{ timestamp }}
${{ config_line }}
#
# Preserved from nbkp run:
#   - All 4 rsync command variants (local→local, local→remote, remote→local, remote→remote)
#   - SSH options (port, key, -o options, proxy jumps as nested ProxyCommand hops)
#   - Rsync filters and filter-file support
#   - Btrfs: snapshot creation, latest symlink, pruning
#   - Hard-link: incremental backups via --link-dest, orphan cleanup, latest symlink,
#     pruning, removal of the new snapshot after a failed rsync
#   - Pre-flight checks, run for every sync before any sync starts:
#       inactive (expected, transient): volume sentinels (.nbkp-vol), endpoint
#         sentinels (.nbkp-src/.nbkp-dst), unreachable hosts
#       broken (infrastructure): rsync presence and version (GNU rsync 3.0+, no
#         openrsync), snapshot tools (btrfs, stat, findmnt, readlink, ls, ln,
#         mkdir, rm), btrfs filesystem / user_subvol_rm_allowed / staging
#         subvolume, FAT/exFAT rejection for hard links, snapshots/ and staging/
#         directories, source and destination latest symlink validity,
#         destination writability
#   - Strictness (--strictness ignore-inactive|ignore-none|ignore-all, default
#     ignore-inactive): inactive syncs are skipped without failing the run,
#     infrastructure errors abort it before any sync starts; ignore-all attempts
#     syncs with infrastructure errors once their sentinels are all present
#   - Failure propagation: syncs downstream of a failed or skipped sync are
#     cancelled, as in nbkp run; a cancellation caused by a skipped
#     (inactive) upstream does not fail the run unless ignore-none, one
#     caused by a disabled upstream never does, one caused by a failed
#     upstream always does
#   - Best-effort steps (orphan cleanup, pruning, removal of a failed snapshot
#     directory) log a warning and never fail the sync
#   - Dry-run and progress mode support (as runtime script arguments)
#   - The run lock: one run at a time per user, shared with nbkp run
#     ($XDG_STATE_HOME/nbkp/run.lock, else ~/.local/state/nbkp/run.lock), taken
#     with flock(1) except in a dry run, which touches no destination
#   - Exit codes: 0 on success (inactive syncs skipped), 1 when a sync failed or
#     the run was aborted, 2 on a usage error
#
# Dropped from nbkp run:
#   - Rich console output (spinners, tables, progress bars) → simple log messages
#   - JSON output mode → not applicable for a shell script
#   - Python runtime / config parsing → all values hardcoded
#   - Endpoint selection (--location, --exclude-location, --network) → resolved once,
#     at generation time; a sync with a volume left out by --exclude-location is
#     always inactive
#   - Paramiko-only SSH options (channel_timeout, disabled_algorithms) → no ssh CLI equivalent
#   - Orphan cleanup during --dry-run → a dry-run here never modifies the destination
#   - The run lock where flock(1) is missing (util-linux; not on stock macOS) →
#     the script warns and runs unlocked
#   - Preflight probes of the orchestrator's own coreutils (date, sort, grep, wc) →
#     the script itself cannot run without them
#   - Volume mount management (udisks LUKS unlock/lock, mount/umount) → credential
#     retrieval depends on keyring/prompt/command backends that don't translate to shell.
#     Volumes with mount config must be manually mounted/umounted before/after running
#     this script. Use: nbkp disks mount -c <config> / nbkp disks umount -c <config>

# Unofficial bash strict mode (http://redsymbol.net/articles/unofficial-bash-strict-mode/)
set -euo pipefail
IFS=$'\n\t'
<% if has_script_dir %>

NBKP_SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
<% endif %>

NBKP_DRY_RUN=false
NBKP_PROGRESS=""
NBKP_STRICTNESS=ignore-inactive

# --- Argument parsing (a usage error exits 2, as in nbkp run) ---
nbkp_usage() {
    printf 'Usage: %s [OPTIONS]\n' "${0##*/}"
    cat <<'NBKP_USAGE'

Run the backup syncs this script was generated with (by nbkp sh).

Options:
  -n, --dry-run           Show what the syncs would do, without changing any
                          destination
  -p, --progress MODE     rsync progress: none, overall, per-file or full
  -S, --strictness LEVEL  How preflight errors affect the run: ignore-inactive
                          (default), ignore-none or ignore-all
  -h, --help              Show this message and exit

Exit codes: 0 on success (inactive syncs skipped), 1 when a sync failed or the
run was aborted, 2 on a usage error.
NBKP_USAGE
}
nbkp_usage_error() {
    echo "Error: $1" >&2
    echo "Try '${0##*/} --help' for help." >&2
    exit 2
}
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) nbkp_usage; exit 0;;
    -n|--dry-run) NBKP_DRY_RUN=true; shift;;
    --progress=*) NBKP_PROGRESS="${1#--progress=}"; shift;;
    --progress|-p)
      [ $# -ge 2 ] || nbkp_usage_error "option $1 requires a value"
      NBKP_PROGRESS="$2"; shift 2;;
    --strictness=*) NBKP_STRICTNESS="${1#--strictness=}"; shift;;
    --strictness|-S)
      [ $# -ge 2 ] || nbkp_usage_error "option $1 requires a value"
      NBKP_STRICTNESS="$2"; shift 2;;
    *) nbkp_usage_error "unknown option: $1";;
  esac
done
case "$NBKP_STRICTNESS" in
  ignore-inactive|ignore-none|ignore-all) ;;
  *) nbkp_usage_error "unknown strictness: $NBKP_STRICTNESS (use 'ignore-inactive', 'ignore-none', or 'ignore-all')";;
esac
case "$NBKP_PROGRESS" in
  ""|none|overall|per-file|full) ;;
  *) nbkp_usage_error "unknown progress mode: $NBKP_PROGRESS (use 'none', 'overall', 'per-file', or 'full')";;
esac

NBKP_FAILURES=0
NBKP_SKIPPED=0
nbkp_log() {
    local IFS=' '
    if [ "$NBKP_DRY_RUN" = true ]; then
        echo "[nbkp] [dry-run] $*" >&2
    else
        echo "[nbkp] $*" >&2
    fi
}

# --- Rsync runtime flags ---
RSYNC_DRY_RUN_FLAG=""
if [ "$NBKP_DRY_RUN" = true ]; then RSYNC_DRY_RUN_FLAG="--dry-run"; fi
RSYNC_PROGRESS_FLAGS=()
case "$NBKP_PROGRESS" in
  none) ;;
  overall) RSYNC_PROGRESS_FLAGS=(--info=progress2 --stats --human-readable);;
  per-file) RSYNC_PROGRESS_FLAGS=(-v --progress --human-readable);;
  full) RSYNC_PROGRESS_FLAGS=(-v --progress --info=progress2 --stats --human-readable);;
  "") ;;
esac

# --- Helpers ---
# GNU rsync >= 3.0 (openrsync rejected); $1 is the output of `rsync --version`.
nbkp_rsync_version_ok() {
    case "$1" in
        *openrsync*) return 1;;
        *"version "[3-9].*|*"version "[1-9][0-9].*) return 0;;
        *) return 1;;
    esac
}
nbkp_contains() {
    case "$1" in *"$2"*) return 0;; *) return 1;; esac
}
# Whether $1 equals one of the '|'-separated words in $2.
nbkp_matches() {
    local IFS='|' word
    for word in $2; do
        if [ "$1" = "$word" ]; then return 0; fi
    done
    return 1
}
# The type of the filesystem holding $1 on macOS, whose BSD stat cannot print
# it: the type in `mount`'s line for the mount point `df -P` reports (its last
# column, which may hold spaces). Empty when it cannot be read.
nbkp_macos_fs_type() {
    local mount_point line
    mount_point="$(df -P "$1" 2>/dev/null \
        | sed -n '2s/^[^ ]*  *[0-9]*  *[0-9]*  *[0-9]*  *[0-9]*%  *//p')"
    [ -n "$mount_point" ] || return 0
    mount 2>/dev/null | while IFS= read -r line; do
        case "$line" in
            *" on $mount_point ("*)
                line="${line#*" on $mount_point ("}"
                printf '%s\n' "${line%%[,)]*}"
                break;;
        esac
    done
}
# Filter stdin to snapshot names, oldest first: exactly the two timestamp forms
# nbkp writes, as parse_snapshot_name accepts them. Other entries are ignored
# (never pruned or removed), which also makes the names safe to splice into
# remote commands. The sort keys skip the time separators (characters 14 and
# 17), so a Linux name (10:15) and a macOS one (10-30) sort by time: ':' sorts
# after '-'.
nbkp_snapshot_names() {
    { grep -E '^[0-9]{4}-[0-9]{2}-[0-9]{2}T([0-9]{2}:[0-9]{2}:[0-9]{2}|[0-9]{2}-[0-9]{2}-[0-9]{2})[.][0-9]{3}Z$' || true; } \
        | sort -k1.1,1.13 -k1.15,1.16 -k1.18,1.24
}
# Whether snapshot name $1 is later than $2, whichever of the two name forms
# each uses.
nbkp_snapshot_after() {
    [ "${1//:/-}" \> "${2//:/-}" ]
}
# Whether latest target $1 names a snapshot in the snapshots dir $2, as nbkp
# writes it: a timestamp-named entry directly under it, not a lookalike
# elsewhere (../other/snapshots/<timestamp>).
nbkp_is_snapshot_target() {
    case "$1" in
        "$2"/*/*) return 1;;
        "$2"/?*) [ -n "$(printf '%s\n' "${1#"$2"/}" | nbkp_snapshot_names)" ];;
        *) return 1;;
    esac
}
<% if portable %>
NBKP_FAILED=" "
NBKP_NOT_RUN=" "
NBKP_DISABLED=" "
nbkp_mark_failed() {
    NBKP_FAILED="${NBKP_FAILED}$1 "
}
nbkp_has_failed() {
    case "$NBKP_FAILED" in *" $1 "*) return 0 ;; *) return 1 ;; esac
}
nbkp_mark_not_run() {
    NBKP_NOT_RUN="${NBKP_NOT_RUN}$1 "
}
nbkp_was_not_run() {
    case "$NBKP_NOT_RUN" in *" $1 "*) return 0 ;; *) return 1 ;; esac
}
nbkp_mark_disabled() {
    NBKP_DISABLED="${NBKP_DISABLED}$1 "
}
nbkp_is_disabled() {
    case "$NBKP_DISABLED" in *" $1 "*) return 0 ;; *) return 1 ;; esac
}
<% else %>
declare -A NBKP_FAILED=()
declare -A NBKP_NOT_RUN=()
declare -A NBKP_DISABLED=()
nbkp_mark_failed() {
    NBKP_FAILED[$1]=1
}
nbkp_has_failed() {
    [ "${NBKP_FAILED[$1]+set}" = "set" ]
}
nbkp_mark_not_run() {
    NBKP_NOT_RUN[$1]=1
}
nbkp_was_not_run() {
    [ "${NBKP_NOT_RUN[$1]+set}" = "set" ]
}
nbkp_mark_disabled() {
    NBKP_DISABLED[$1]=1
}
nbkp_is_disabled() {
    [ "${NBKP_DISABLED[$1]+set}" = "set" ]
}
<% endif %>
# Abort before any sync starts when preflight results are fatal under the
# chosen strictness. Arguments: the preflight return code of each sync.
nbkp_enforce_strictness() {
    local rc broken=0 inactive=0 fatal=0
    for rc in "$@"; do
        case "$rc" in
            0) ;;
            1) broken=$((broken + 1));;
            *) inactive=$((inactive + 1));;
        esac
    done
    case "$NBKP_STRICTNESS" in
        ignore-none) fatal=$((broken + inactive));;
        ignore-inactive) fatal=$broken;;
        ignore-all) fatal=0;;
    esac
    if [ "$fatal" -gt 0 ]; then
        nbkp_log "Aborting: preflight checks found errors in $fatal sync(s)"
        exit 1
    fi
}
# Count a sync that did not run because of expected inactivity (its own, or
# an upstream's): a failure only under ignore-none, as in nbkp run.
nbkp_count_inactive() {
    if [ "$NBKP_STRICTNESS" = ignore-none ]; then
        NBKP_FAILURES=$((NBKP_FAILURES + 1))
    else
        NBKP_SKIPPED=$((NBKP_SKIPPED + 1))
    fi
}
# nbkp_run_sync SLUG FN PREFLIGHT_RC [UPSTREAM_FN...]
# Cancels when an upstream sync failed (a failure), did not run (counted
# like the inactivity it stems from) or is disabled (never a failure, as a
# disabled sync is not), skips inactive syncs, otherwise runs FN
# in a subshell with `set -e` in force: a function called in a `||` or `if`
# context runs with errexit disabled, which would let a failed rsync carry on
# into snapshotting. Under ignore-all, syncs with preflight errors (rc 1) are
# attempted: their sentinel checks, which run first, all passed.
nbkp_run_sync() {
    local slug="$1" fn="$2" pf="$3" dep rc failed_dep="" not_run_dep="" disabled_dep=""
    shift 3
    for dep in "$@"; do
        if nbkp_has_failed "$dep"; then
            failed_dep="${failed_dep:-$dep}"
        elif nbkp_was_not_run "$dep"; then
            not_run_dep="${not_run_dep:-$dep}"
        elif nbkp_is_disabled "$dep"; then
            disabled_dep="${disabled_dep:-$dep}"
        fi
    done
    if [ -n "$failed_dep" ]; then
        nbkp_log "CANCELLED $slug: upstream sync failed ($failed_dep)"
        nbkp_mark_failed "$fn"; NBKP_FAILURES=$((NBKP_FAILURES + 1)); return 0
    fi
    if [ -n "$not_run_dep" ]; then
        nbkp_log "CANCELLED $slug: upstream sync was skipped ($not_run_dep)"
        nbkp_mark_not_run "$fn"; nbkp_count_inactive; return 0
    fi
    if [ -n "$disabled_dep" ]; then
        nbkp_log "CANCELLED $slug: upstream sync is disabled ($disabled_dep)"
        nbkp_mark_disabled "$fn"; NBKP_SKIPPED=$((NBKP_SKIPPED + 1)); return 0
    fi
    case "$pf" in
        2) nbkp_log "SKIPPED $slug: inactive"
           nbkp_mark_not_run "$fn"; nbkp_count_inactive; return 0;;
        3) nbkp_log "SKIPPED $slug: source snapshot pending (dry-run)"
           NBKP_SKIPPED=$((NBKP_SKIPPED + 1)); return 0;;
        1) if [ "$NBKP_STRICTNESS" = ignore-all ]; then
               nbkp_log "WARN $slug: preflight errors ignored (ignore-all), attempting"
           else
               nbkp_log "SKIPPED $slug: preflight errors"
               nbkp_mark_not_run "$fn"; NBKP_FAILURES=$((NBKP_FAILURES + 1)); return 0
           fi;;
    esac
    set +e
    ( set -e; "$fn" )
    rc=$?
    set -e
    if [ "$rc" -ne 0 ]; then
        nbkp_log "FAILED $slug"
        nbkp_mark_failed "$fn"
        NBKP_FAILURES=$((NBKP_FAILURES + 1))
    fi
    return 0
}

# --- Sync functions ---
<% for sync in syncs %>
<% if sync.stub_reason and sync.enabled %>

# : location-excluded — ${{ sync.slug }}: ${{ sync.stub_reason }}
${{ sync.fn_name }}_preflight() {
${{ sync.preflight | indent(4, first=true) }}
}
<% elif sync.stub_reason %>

# : disabled — ${{ sync.slug }} (not rendered: ${{ sync.stub_reason }})
<% elif sync.enabled %>

${{ sync_functions(sync) | trim }}
<% else %>

# : disabled — ${{ sync.slug }}
${{ sync_functions(sync) | trim | comment_out }}
<% endif %>
<% endfor %>

# --- Run lock (the one nbkp run holds), for the rest of the script ---
if [ "$NBKP_DRY_RUN" = false ]; then
    case "${XDG_STATE_HOME:-}" in
        /*) NBKP_RUN_LOCK="$XDG_STATE_HOME/${{ run_lock_state_subpath }}";;
        *) NBKP_RUN_LOCK="$HOME/.local/state/${{ run_lock_state_subpath }}";;
    esac
    if command -v flock >/dev/null 2>&1; then
        mkdir -p "$(dirname "$NBKP_RUN_LOCK")"
        exec 9>>"$NBKP_RUN_LOCK"
        if ! flock -n 9; then
            nbkp_log "ERROR: another nbkp command (a run, a mount, a prune, …) is in progress (it holds $NBKP_RUN_LOCK). Wait for it to finish, then run again."
            exit 1
        fi
    else
        nbkp_log "WARN: flock not found: running without the run lock ($NBKP_RUN_LOCK)"
    fi
fi

# --- Preflight checks (all syncs, before any sync starts) ---
<% for sync in enabled_syncs %>
${{ sync.fn_name }}_preflight && NBKP_PF_${{ sync.fn_name }}=0 || NBKP_PF_${{ sync.fn_name }}=$?
<% endfor %>
nbkp_enforce_strictness<% for sync in enabled_syncs %> "$NBKP_PF_${{ sync.fn_name }}"<% endfor %>


# --- Run all syncs ---
<% for sync in syncs %>
<% if sync.enabled %>
nbkp_run_sync ${{ sync.slug }} ${{ sync.fn_name }} "$NBKP_PF_${{ sync.fn_name }}"<% for dep in sync.predecessors %> ${{ dep }}<% endfor %>

<% else %>
# ${{ sync.fn_name }}  # disabled
nbkp_log "SKIPPED ${{ sync.slug }}: disabled"
nbkp_mark_disabled ${{ sync.fn_name }}
<% endif %>
<% endfor %>

# --- Summary ---
if [ "$NBKP_FAILURES" -gt 0 ]; then
    nbkp_log "$NBKP_FAILURES sync(s) failed"
    exit 1
fi
if [ "$NBKP_SKIPPED" -gt 0 ]; then
    nbkp_log "All active syncs completed successfully ($NBKP_SKIPPED skipped)"
else
    nbkp_log "All syncs completed successfully"
fi
