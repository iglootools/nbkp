# The Python patch release here and the uv tag below match mise.toml's [tools] pins, so the
# btrfs tests run on the same interpreter and uv as local development and CI. Move them
# together with mise.toml (for Python, see "Python versions" in docs/building-and-testing.md).
# The `# renovate:` comments make Renovate track both pins through the datasources its mise
# manager uses for mise.toml, so each lands in the same update as its mise.toml twin (see
# renovate.json).
# renovate: datasource=github-tags depName=python/cpython
FROM python:3.15.2-slim

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    btrfs-progs \
    git \
    rsync \
    && rm -rf /var/lib/apt/lists/*

# Pinned uv binary rather than pip-installing the build tool: no PyPI resolution at image
# build time. `git` above stays needed — uv-dynamic-versioning shells out to it to resolve
# the editable install's version.
# renovate: datasource=github-releases depName=astral-sh/uv
COPY --from=ghcr.io/astral-sh/uv:0.13.7 /uv /uvx /usr/local/bin/

# /app is a rw bind mount of the host checkout, so every uv write has to be kept off it:
#  - UV_PROJECT_ENVIRONMENT: the venv lands in /tmp instead of clobbering the host's macOS
#    .venv. This replaces the POETRY_VIRTUALENVS_IN_PROJECT/PATH pair that used to be set
#    on the test side; keeping it in the image means the escape hatch travels with it.
#  - UV_FROZEN: `uv sync` re-locks by default and would rewrite the host's uv.lock from
#    inside a Linux container. This exposure is new relative to poetry.
#  - UV_CACHE_DIR / UV_LINK_MODE: keep the cache and hardlink target on the container fs.
#  - UV_PYTHON / UV_PYTHON_DOWNLOADS: use this image's interpreter, never a downloaded one.
#  - UV_NO_SYNC: the entrypoint's `uv sync` is the only sync, so a `uv run` command cannot
#    re-sync and undo the packages it deliberately skips (see btrfs-local-entrypoint.sh).
ENV UV_PROJECT_ENVIRONMENT=/tmp/venv \
    UV_FROZEN=1 \
    UV_NO_SYNC=1 \
    UV_CACHE_DIR=/tmp/uv-cache \
    UV_LINK_MODE=copy \
    UV_PYTHON=/usr/local/bin/python3 \
    UV_PYTHON_DOWNLOADS=never \
    PATH=/tmp/venv/bin:$PATH

# Create btrfs loopback filesystem at container startup
COPY nbkp/remote/testkit/dockerbuild/btrfs-local-entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

WORKDIR /app

ENTRYPOINT ["/entrypoint.sh"]
